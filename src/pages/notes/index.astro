---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const notes = (await getCollection('notes'))
  .sort((a, b) => (a.data.year.localeCompare(b.data.year)) || (a.data.order - b.data.order) || a.data.paper.localeCompare(b.data.paper));

// group by year
const byYear = new Map<string, typeof notes>();
for (const n of notes) {
  const y = n.data.year;
  if (!byYear.has(y)) byYear.set(y, [] as any);
  byYear.get(y)!.push(n);
}
const years = Array.from(byYear.keys());
---
<Base title="Cambridge notes" description="Economics notes from the Cambridge Tripos by Shivansh Pandey.">
  <div class="article-head">
    <p class="eyebrow">Cambridge Economics Tripos</p>
    <h1>Notes</h1>
    <p class="lead">My economics notes from Cambridge, organised by year and paper. Shared in the spirit of the notes friends shared with me. Corrections welcome.</p>
  </div>

  {years.length === 0 ? (
    <p class="muted">Notes are being uploaded shortly.</p>
  ) : (
    years.map((year) => (
      <section>
        <div class="section-head"><h2>{year}</h2></div>
        <div class="rows">
          {byYear.get(year)!.map((n) => (
            <div class="row" style="align-items:flex-start">
              <div style="flex:1 1 20rem">
                <div class="row__title">{n.data.paper}</div>
                {n.data.description && <p class="row__desc" style="flex-basis:auto; margin-top:.25rem">{n.data.description}</p>}
              </div>
              <div style="display:flex; flex-wrap:wrap; gap:.5rem; margin-left:auto; align-items:center">
                {n.data.files.length === 0 ? (
                  <span class="faint small">coming soon</span>
                ) : (
                  n.data.files.map((f) => (
                    <a class="btn" href={f.href} target="_blank" rel="noopener">{f.label}</a>
                  ))
                )}
              </div>
            </div>
          ))}
        </div>
      </section>
    ))
  )}

  <section>
    <div class="section-head"><h2>Resources</h2></div>
    <p class="muted" style="max-width:var(--measure); margin-bottom:1.25rem">
      Things that helped me, kept here so they help someone else. The concept notes
      and study guides below are Dr Kumar Aniket's, shared from
      <a class="link" href="https://aniket.co.uk/new/public/dos.html" target="_blank" rel="noopener">his teaching pages</a>;
      the course material and past papers are the Cambridge Economics Faculty's.
    </p>
    <div class="rows">
      <div class="row" style="align-items:flex-start">
        <div style="flex:1 1 20rem">
          <div class="row__title">Concept notes (Kumar Aniket)</div>
          <p class="row__desc" style="flex-basis:auto; margin-top:.25rem">Short notes clarifying tricky ideas: difference-in-differences, OLS, the envelope theorem, duality, IS-LM and AA-DD, exchange-rate overshooting, and the maths (Lagrangians, Kuhn-Tucker, the Leibniz rule).</p>
        </div>
        <div style="display:flex; flex-wrap:wrap; gap:.5rem; margin-left:auto; align-items:center">
          <a class="btn" href="https://aniket.co.uk/new/public/notes.html" target="_blank" rel="noopener">Open notes</a>
        </div>
      </div>
      <div class="row" style="align-items:flex-start">
        <div style="flex:1 1 20rem">
          <div class="row__title">Reading list &amp; Tripos study guide (Kumar Aniket)</div>
          <p class="row__desc" style="flex-basis:auto; margin-top:.25rem">A fresher's reading list and a guide to how the Tripos fits together.</p>
        </div>
        <div style="display:flex; flex-wrap:wrap; gap:.5rem; margin-left:auto; align-items:center">
          <a class="btn" href="https://www.aniket.co.uk/teaching/dos/readinglist-part1.pdf" target="_blank" rel="noopener">Reading list</a>
          <a class="btn" href="https://www.aniket.co.uk/teaching/Study_Guide.pdf" target="_blank" rel="noopener">Study guide</a>
        </div>
      </div>
      <div class="row" style="align-items:flex-start">
        <div style="flex:1 1 20rem">
          <div class="row__title">Cambridge Economics Faculty</div>
          <p class="row__desc" style="flex-basis:auto; margin-top:.25rem">Official course material by part, and the past exam papers archive.</p>
        </div>
        <div style="display:flex; flex-wrap:wrap; gap:.5rem; margin-left:auto; align-items:center">
          <a class="btn" href="https://www.econ.cam.ac.uk/intranet/ugrad/index.html?part=PI" target="_blank" rel="noopener">Part I</a>
          <a class="btn" href="https://www.econ.cam.ac.uk/intranet/ugrad/index.html?part=PIIA" target="_blank" rel="noopener">Part IIA</a>
          <a class="btn" href="https://www.econ.cam.ac.uk/intranet/ugrad/index.html?part=PIIB" target="_blank" rel="noopener">Part IIB</a>
          <a class="btn" href="https://www.econ.cam.ac.uk/intranet/exams/" target="_blank" rel="noopener">Past papers</a>
        </div>
      </div>
    </div>
  </section>
</Base>
