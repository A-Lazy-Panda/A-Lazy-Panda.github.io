---
import { SITE, SOCIALS } from '../consts';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap-wide site-footer__inner">
    <span>© {year} {SITE.name}</span>
    <span class="dot">·</span>
    {SOCIALS.map((s) => (
      <a href={s.href} rel={s.href.startsWith('http') ? 'me noopener' : undefined} target={s.href.startsWith('http') ? '_blank' : undefined}>{s.label}</a>
    ))}
    <span style="margin-left:auto" class="faint small">Built with Astro</span>
  </div>
</footer>
